<launch>
    <arg name="config" default='gazebo' />
<!--     <arg name="num" type="int" default=1 /> -->
    <param name="config" value="$(arg config)" />
    <node pkg="master" type="global_config.py" name="global_config" output="screen">
        <rosparam file="$(find master)/config/global_config_$(arg config)_uav_ugv.yaml" command="load" />
    </node>
</launch>